{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build LightsOut2 mod",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Source/LightsOut2/LightsOut2/LightsOut2.csproj"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build and deploy LightsOut2",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/Source/prepare-rimworld.ps1"
      ],
      "problemMatcher": []
    }
  ]
}
