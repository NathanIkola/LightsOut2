{
  "dotnet.defaultSolution": "Source/LightsOut2/LightsOut2.sln",
  "dotnet.backgroundAnalysis.analyzerDiagnosticsScope": "fullSolution",
  "[csharp]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/bin": true,
    "**/obj": true,
    "**/TestResults": true
  }
}
